{
	"Q": {
		"pluginInfo": {
			"Sharing": {
				"version": "0.2",
				"compatible": "0.1",
				"requires": {
					"Q": "1.0",
					"Users": "1.0",
					"Streams": "1.0",
					"Places": "1.0",
					"Calendars": "0.1"
				},
				"connections": []
			}
		},
		/*
			Sharing_Guard (ro#586): the plugin's own methods are the only write
			path to its streams. Generic Streams handlers write streams without
			asking a type's rules -- Streams/related never access-checks the
			related stream, Streams/form checks nothing, Streams/message ignores
			post: true -- so the rules sit on the events every write passes
			through, for every type the plugin owns. A type added to the plugin
			needs its line in each of these, which SharingPermissionModelTest
			in the ro repo checks.
		*/
		"handlersBeforeEvent": {
			"Q/responseExtras": ["Sharing/before/Q_responseExtras"],
			"Streams/close/Sharing/listing": ["Sharing/before/Streams_close_Sharing_listing"],
			"Streams/Stream/save/Sharing/listing": ["Sharing/before/guardSave"],
			"Streams/Stream/save/Sharing/listing/private": ["Sharing/before/guardSave"],
			"Streams/Stream/save/Sharing/engagement": ["Sharing/before/guardSave"],
			"Streams/Stream/save/Sharing/notices": ["Sharing/before/guardSave"],
			"Streams/relateTo/Sharing/listing": ["Sharing/before/guardRelation"],
			"Streams/relateTo/Sharing/listing/private": ["Sharing/before/guardRelation"],
			"Streams/relateTo/Sharing/engagement": ["Sharing/before/guardRelation"],
			"Streams/relateTo/Sharing/notices": ["Sharing/before/guardRelation"],
			"Streams/relateFrom/Sharing/listing": ["Sharing/before/guardRelation"],
			"Streams/relateFrom/Sharing/listing/private": ["Sharing/before/guardRelation"],
			"Streams/relateFrom/Sharing/engagement": ["Sharing/before/guardRelation"],
			"Streams/relateFrom/Sharing/notices": ["Sharing/before/guardRelation"],
			"Streams/unrelateTo/Sharing/listing": ["Sharing/before/guardRelation"],
			"Streams/unrelateTo/Sharing/listing/private": ["Sharing/before/guardRelation"],
			"Streams/unrelateTo/Sharing/engagement": ["Sharing/before/guardRelation"],
			"Streams/unrelateTo/Sharing/notices": ["Sharing/before/guardRelation"],
			"Streams/unrelateFrom/Sharing/listing": ["Sharing/before/guardRelation"],
			"Streams/unrelateFrom/Sharing/listing/private": ["Sharing/before/guardRelation"],
			"Streams/unrelateFrom/Sharing/engagement": ["Sharing/before/guardRelation"],
			"Streams/unrelateFrom/Sharing/notices": ["Sharing/before/guardRelation"],
			"Streams/post/Sharing/listing": ["Sharing/before/guardPost", "Sharing/before/holdNode"],
			"Streams/post/Sharing/listing/private": ["Sharing/before/guardPost", "Sharing/before/holdNode"],
			"Streams/post/Sharing/engagement": ["Sharing/before/guardPost", "Sharing/before/holdNode"],
			"Streams/post/Sharing/notices": ["Sharing/before/guardPost", "Sharing/before/holdNode"],
			"Streams/message/Streams/unrelatedTo": ["Sharing/before/holdNode"],
			"Q/Utils/sendToNode": ["Sharing/before/Q_Utils_sendToNode"]
		},
		/*
			ro#863: postMessages() calls node before it returns, which inside
			the listing lock is before the COMMIT. holdNode (above) stops that
			while the lock is held, for posts on a Sharing stream and for the
			Streams/unrelatedTo that close() posts on the community category;
			outside a lock it does nothing. This keeps what would have been
			sent, and Sharing_Listing::locked() sends it once the COMMIT
			returns -- or drops it on a rollback.

			ro#868: a node call made directly under the lock (propose()'s
			Streams/Stream/create, from Streams_Stream::afterSaveExecute) has no
			flag to clear, and sendToNode() ignores its {before} result. So
			locked() points Q/nodeInternal at nothing while the lock is held,
			and Sharing/before/Q_Utils_sendToNode keeps each such call for the
			same after-COMMIT send.
		*/
		"handlersAfterEvent": {
			"Streams/postMessages": ["Sharing/after/Streams_postMessages"]
		},
		/*
			Pages in "routes", the API in "routes@end". Q_Uri::url() walks the
			blocks start, routes, end (each reversed) and takes the first pattern
			the fields satisfy, so with the API pattern in routes@start every url
			for a Sharing action -- a dashboard tab, a share link -- came out as
			Q/plugins/Sharing/<action>. Here the page patterns win generation
			(Sharing/listings -> /sharing, Sharing/listing with publisherId and
			listingId -> /sharing/<p>/<id>) and the API pattern only matches
			Q.req("Sharing/listing") calls that carry no route fields. Inbound is
			unaffected. "sharing/engagements/mine" is three segments because
			Communities' ":communityId/:tab" claims every two-segment path, and
			it is declared AFTER the :publisherId/:listingId pattern because
			within a block the last-declared route is tried first inbound.
		*/
		"routes": {
			"sharing": {"module": "Sharing", "action": "listings"},
			"sharing/engagement/:publisherId/:engagementId": {"module": "Sharing", "action": "engagement"},
			"sharing/:publisherId/:listingId": {"module": "Sharing", "action": "listing"},
			"sharing/engagements/mine": {"module": "Sharing", "action": "engagements"}
		},
		"routes@end": {
			"Q/plugins/Sharing/:action": {"module": "Sharing"}
		}
	},
	"Sharing": {
		/*
			Four gates, not two: a community can say "teachers offer, members
			request; members post needs, teachers and members volunteer".
			Checked with Users::roles() against the current community; the
			host app overrides these lists in its own app.json. Guests are in
			none by design: they can browse but not transact. Values are
			interpolated with {{app}} so an app can name its own roles. The
			key names are fixed (renaming a config key later is debt); giving
			several the same default is free.
		*/
		"labels": {
			"canCreateOffer": ["Users/owners", "Users/admins", "Users/members", "Users/teachers"],
			"canRespondToOffer": ["Users/owners", "Users/admins", "Users/members"],
			"canCreateNeed": ["Users/owners", "Users/admins", "Users/members", "Users/teachers"],
			"canRespondToNeed": ["Users/owners", "Users/admins", "Users/members", "Users/teachers"],
			/*
				Who may resolve what a party abandoned (ro#586): cancel an
				accepted or active engagement, pause or close someone else's
				listing. Not a direction gate.
			*/
			"canResolve": ["Users/owners", "Users/admins"]
		}
	},
	"Streams": {
		/*
			SHARING_PLUGIN_CONFIG_DIR/streams.json, per
			Streams::userStreamsTree(), which resolves a non-app key as
			<NAME>_PLUGIN_CONFIG_DIR. It describes Sharing/notices so
			subscribing picks up the delivery rule below.
		*/
		"userStreams": {
			"Sharing": "streams.json"
		},
		/*
			Push where the member has a device, and email; SMS is deliberately
			not a fallback -- a lending community can generate a lot of these,
			the plugin ships no mobile template, and outbound SMS has no
			timeout upstream (ro#729). A member who wants none of it
			unsubscribes from their notice stream, which Sharing_Notice
			respects because it only subscribes at creation.
		*/
		"rules": {
			"deliver": {
				"sharing": [["devices", "email"]]
			}
		},
		"types": {
			/*
				Sharing/listing: readLevel 30 = Streams::$READ_LEVEL['participants'],
				writeLevel 23 = Streams::$WRITE_LEVEL['relate']. Members can see
				a listing; the relate level is kept for existing rows, but since
				ro#586 no relation to a listing is made outside the plugin
				(Sharing_Guard), so it grants nothing an engagement needs. Only
				the publisher edits, and only title and content through the
				generic path; what was agreed is snapshotted onto the engagement
				at acceptance, so an edit cannot change it. Attributes (paused,
				direction, kind, ...) change only in the plugin.

				create: false -- Sharing_Listing::create() applies the label
				gates and validates the attributes; the generic POST would take
				whatever attributes and access levels the caller sent (ro#586,
				audit R03). close: false -- Sharing/listing/put closes under the
				listing's lock. Config cannot hold the named constants, so the
				numbers are annotated here and code must use the names.
			*/
			"Sharing/listing": {
				"emoji": "🤝",
				"create": false,
				"close": false,
				"edit": ["title", "content"],
				"defaults": {
					"title": "Untitled listing",
					"readLevel": 30,
					"writeLevel": 23,
					"adminLevel": 0
				},
				"messages": {
					"Streams/chat/message": {"post": true},
					/*
						propose() posts this on the listing as well as on the
						engagement, so the type has to declare it -- an
						undeclared message type has no description or subject
						of its own. Not post: true: like every other lifecycle
						message it is posted server-side. Streams/message POST
						does not read post: true -- it takes any type declared
						with a truthy entry -- so what keeps clients out is
						Sharing/before/guardPost.
					*/
					"Sharing/engagement/proposed": {
						"description": "Someone responded to a listing"
					}
				}
			},
			/*
				The listing's private data (exact address, handoff
				instructions, door codes). Attributes are one JSON blob served
				whole to anyone at read level, so this is a separate stream
				with readLevel none: only its publisher reads it, and the
				server copies it onto each engagement on acceptance.
			*/
			"Sharing/listing/private": {
				"emoji": "🔒",
				"create": false,
				"close": false,
				"edit": false,
				"defaults": {
					"title": "Private listing details",
					"readLevel": 0,
					"writeLevel": 0,
					"adminLevel": 0
				}
			},
			/*
				Sharing/engagement: create is false because the generic POST
				would let a responder start one in any state, with any listing
				attribute, as its owner (ro#586, audit R03); propose() is the
				only way in. edit is false because Streams/stream/put sets every
				attribute the client sends, and the publisher here is the
				responder, who must not be able to write persistedState. Every
				change goes through Sharing_Engagement::transition(). Close is
				false too: cancellation is a transition, not a close. None of
				the state-changing messages carries post: true -- transition()
				posts them server-side after validating; only chat is
				client-postable, and Sharing/before/guardPost enforces that.
			*/
			/*
				One notice stream per user, which they publish and subscribe
				to, and which carries the deliverable copy of an engagement
				event (ro#769). Lifecycle messages on the engagement itself
				reach nobody: delivery runs off Streams_Subscription, and
				subscribing both parties to the engagement would notify each
				of them of their own actions, since the actor-skip in
				notifyParticipants is commented out.

				readLevel 0: nobody but its publisher, not even admins.
				create: false -- only Sharing_Notice::stream() makes these.
				evenIfOnline: the counterparty is not the person looking at
				the page, so an open tab elsewhere must not suppress the mail.
			*/
			"Sharing/notices": {
				"emoji": "🔔",
				"create": false,
				"close": false,
				"edit": false,
				"defaults": {
					"title": "Sharing notices",
					"readLevel": 0,
					"writeLevel": 0,
					"adminLevel": 0
				},
				"messages": {
					"Sharing/engagement/proposed": {
						"description": "Someone responded to your listing",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/proposed"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/accepted": {
						"description": "Your response was accepted",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/accepted"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/rejected": {
						"description": "Your response was declined",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/rejected"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/cancelled": {
						"description": "An engagement was cancelled",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/cancelled"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/handedOver": {
						"description": "Something changed hands",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/handedOver"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/started": {
						"description": "An engagement started",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/started"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/returned": {
						"description": "Something was returned",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/returned"]],
						"evenIfOnline": true
					},
					"Sharing/engagement/completed": {
						"description": "An engagement is complete",
						"subject": ["Sharing/content", ["notifications", "Sharing/engagement/completed"]],
						"evenIfOnline": true
					}
				}
			},
			"Sharing/engagement": {
				"emoji": "📨",
				"create": false,
				"close": false,
				"edit": false,
				"defaults": {
					"title": "Engagement",
					"readLevel": 0,
					"writeLevel": 0,
					"adminLevel": 0
				},
				"messages": {
					"Streams/chat/message": {"post": true},
					"Sharing/engagement/proposed": {},
					"Sharing/engagement/accepted": {},
					"Sharing/engagement/rejected": {},
					"Sharing/engagement/cancelled": {},
					"Sharing/engagement/handedOver": {},
					"Sharing/engagement/started": {},
					"Sharing/engagement/returned": {},
					"Sharing/engagement/completed": {}
				}
			}
		}
	}
}
